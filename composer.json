{
    "name": "jeromejhipolito/laravel-api-versioning",
    "description": "Header-based API versioning with version flags for Laravel. Supports semantic versioning and feature flag-like version control.",
    "keywords": ["laravel", "api", "versioning", "version", "header", "semver", "feature-flags"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jerome Hipolito",
            "email": "jeromejhipolito@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^2.0|^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "JeromeJHipolito\\ApiVersioning\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeromeJHipolito\\ApiVersioning\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeromeJHipolito\\ApiVersioning\\ApiVersioningServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
